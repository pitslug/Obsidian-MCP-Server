# Non-sensitive configuration for obsidian-mcp.
#
# Copy to $ENVDIR/obsidian-mcp.env on the server. Nothing sensitive belongs
# here — passwords, passphrases and tokens are Docker secrets, consumed through
# the *_FILE variables set in the compose file.

# --- CouchDB ---------------------------------------------------------------

# Base URL, without the database name. The ?db= form from the LiveSync setup
# URI is also accepted.
COUCHDB_URL=https://couchdb.slugworx.net
COUCHDB_DATABASE=obsidiandb
COUCHDB_USER=obsidian
# COUCHDB_PASSWORD comes from the Docker secret via COUCHDB_PASSWORD_FILE.

# --- Storage format --------------------------------------------------------
#
# Normally leave these unset. The server reads the vault's own settings from
# its milestone document, which is more reliable than restating them here.
# Set one only to override a vault whose devices disagree, or which has no
# milestone document.
#
# E2EE_ENABLED=false
# PATH_OBFUSCATION=false
# HASH_ALG=xxhash64
# CHUNK_SPLITTER=v3-rabin-karp
# E2EE_ALGORITHM=v2
# E2EE_PASSPHRASE comes from a Docker secret via E2EE_PASSPHRASE_FILE.

# --- Behaviour -------------------------------------------------------------

# Disables every write tool. Leave on until the write path has been through
# its own acceptance gate.
READ_ONLY=true

# Largest attachment returned to a caller, in bytes.
ATTACHMENT_SIZE_CAP=26214400

# Maximum notes a single write plan may touch.
PLAN_CEILING=500

# --- Transport -------------------------------------------------------------

MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8080
# MCP_BEARER_TOKEN comes from the Docker secret via MCP_BEARER_TOKEN_FILE.

# --- Logging ---------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# Non-sensitive configuration for obsidian-mcp.
#
# Copy to $ENVDIR/obsidian-mcp.env on the server. Nothing sensitive belongs
# here - passwords, passphrases and tokens are Docker secrets, consumed through
# the *_FILE variables set in the compose file.

# --- CouchDB ---------------------------------------------------------------

# Base URL, without the database name. The ?db= form from the LiveSync setup
# URI is also accepted.
COUCHDB_URL=https://couchdb.slugworx.net
COUCHDB_DATABASE=obsidiandb
COUCHDB_USER=obsidian
# COUCHDB_PASSWORD comes from the Docker secret via COUCHDB_PASSWORD_FILE.

# --- Storage format --------------------------------------------------------
#
# Normally leave these unset. The server reads the vault's own settings from
# its milestone document, which is more reliable than restating them here.
# Set one only to override a vault whose devices disagree, or which has no
# milestone document.
#
# E2EE_ENABLED=false
# PATH_OBFUSCATION=false
# HASH_ALG=xxhash64
# CHUNK_SPLITTER=v3-rabin-karp
# E2EE_ALGORITHM=v2
# E2EE_PASSPHRASE comes from a Docker secret via E2EE_PASSPHRASE_FILE.

# --- Storage ---------------------------------------------------------------
#
# All three default to somewhere under /data, which the compose file maps to
# $DATADIR/obsidian-mcp. Normally leave them unset.
#
# The replica and the index are derived: delete either and it rebuilds from
# CouchDB. The transcript store is not. A transcription of a handwritten page
# exists because a model read the ink once, nothing can recompute it, and it is
# kept in its own file so that an index rebuild cannot take it with it.
#
# REPLICA_PATH=/data/replica
# INDEX_PATH=/data/index.sqlite
# TRANSCRIPT_PATH=/data/transcripts.sqlite

# --- Behaviour -------------------------------------------------------------

# Disables every write tool that touches the vault. Leave on until the write
# path has been through its own acceptance gate.
#
# save_transcription stays available regardless, because it cannot reach the
# vault: it writes to the local transcript store and nothing else.
READ_ONLY=true

# Largest attachment returned to a caller, in bytes.
ATTACHMENT_SIZE_CAP=26214400

# Maximum notes a single write plan may touch.
PLAN_CEILING=500

# --- Daily notes -----------------------------------------------------------

# The zone whose civil date counts as "today" for append_daily.
#
# Not optional in a container. The default is the host's zone, which here is
# UTC, and Brisbane is ten hours ahead of it: every capture made after 2pm
# local would be filed under the previous day, and nothing would report an
# error while it happened.
VAULT_TIMEZONE=Australia/Brisbane

# Path template for the daily note, e.g. daily/YYYY-MM-DD.md.
#
# Normally leave this unset. Obsidian keeps the real setting in .obsidian/,
# which this vault does not sync, so the format is inferred from the dated
# filenames already in the vault and reported on every append. Set it only if
# the inference picks the wrong folder, or if the vault has fewer than two
# dated notes for it to learn from.
#
# DAILY_NOTE_PATH=daily/YYYY-MM-DD.md

# --- Transport -------------------------------------------------------------

MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8080

# --- Authentication --------------------------------------------------------

# oauth | bearer | none. Inferred from what is set below when only one applies,
# and required when both an issuer and a shared token are present.
#
# There is no default for the HTTP transport. A server that quietly served the
# vault to anyone is not a failure mode worth allowing, so an unauthenticated
# deployment has to say AUTH_MODE=none in words.
AUTH_MODE=oauth

# The authorization server. Pocket-ID, same instance everything else here uses.
OAUTH_ISSUER=https://auth.slugworx.net

# This server's public URL, exactly as a client addresses it, path included.
#
# The most load-bearing value here. The client sends it as the RFC 8707
# `resource` parameter, Pocket-ID stamps it into the token as the audience, and
# this server accepts a token only if it matches. A trailing slash, a missing
# /mcp, or http instead of https rejects every token, and the log will say the
# token was not issued for this server rather than that this line is wrong.
#
# It must also match the API you register in Pocket-ID, and the connector URL
# you type into Claude.
MCP_PUBLIC_URL=https://obsidian-mcp.slugworx.net/mcp

# Only needed if the issuer publishes no discovery document. Pocket-ID does,
# so leave this unset.
#
# OAUTH_JWKS_URI=

# The interim shared token, for AUTH_MODE=bearer. Every caller holding it is
# the same caller as far as this server can tell, so it cannot express
# read-only access the way scopes can.
#
# MCP_BEARER_TOKEN comes from the Docker secret via MCP_BEARER_TOKEN_FILE.

# --- Logging ---------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info
